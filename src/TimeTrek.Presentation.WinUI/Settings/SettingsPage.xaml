<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TimeTrek.Presentation.WinUI.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="OnSizeChanged">
  <ScrollViewer><StackPanel Padding="24" Spacing="16">
    <Grid><TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Grid>
    <TextBox x:Name="SearchBox" PlaceholderText="Search all settings" AutomationProperties.Name="Search Settings" TextChanged="OnSearchChanged" />
    <Grid x:Name="SettingsGrid" ColumnSpacing="16" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" /><ComboBox Header="Week starts" x:Name="WeekStart"><ComboBoxItem Content="Windows default" Tag="WindowsDefault" /><ComboBoxItem Content="Sunday" Tag="Sunday" /><ComboBoxItem Content="Monday" Tag="Monday" /></ComboBox><Button Content="Rerun setup wizard (preserves data)" /></StackPanel></Border>
      <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" /><ComboBox Header="Mode" x:Name="Appearance"><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" /><ComboBoxItem Content="Follow Windows" Tag="FollowWindows" /><ComboBoxItem Content="Scheduled" Tag="Scheduled" /></ComboBox><StackPanel Orientation="Horizontal" Spacing="8"><TimePicker x:Name="LightStart" Header="Light begins" ClockIdentifier="24HourClock" /><TimePicker x:Name="DarkStart" Header="Dark begins" ClockIdentifier="24HourClock" /></StackPanel><TextBlock Text="GitHub Default · Canvas / Surface / Accent" /></StackPanel></Border>
      <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Timing" Style="{StaticResource SubtitleTextBlockStyle}" /><NumberBox x:Name="DefaultMinutes" Header="Default minutes" Minimum="1" Maximum="10080" /><ToggleSwitch x:Name="Rounding" Header="Rounding" /><NumberBox x:Name="RoundingIncrement" Header="Nearest minutes" Minimum="1" Maximum="60" /></StackPanel></Border>
      <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Pomodoro" Style="{StaticResource SubtitleTextBlockStyle}" /><NumberBox x:Name="PomodoroWork" Header="Work minutes" Minimum="1" Maximum="1440" /><NumberBox x:Name="PomodoroBreak" Header="Break minutes" Minimum="1" Maximum="1440" /><NumberBox x:Name="PomodoroBuffer" Header="Confirmation buffer minutes" Minimum="1" Maximum="60" /><ToggleSwitch x:Name="BreaksBillable" Header="Breaks are billable" /></StackPanel></Border>
      <Border Grid.Row="2" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Billing" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="Billing" Header="Enable billing fields" /><TextBlock Text="Rates are edited on scoped Categories." TextWrapping="Wrap" /></StackPanel></Border>
      <Border Grid.Row="2" Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Activity &amp; Privacy" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="ForegroundTracking" Header="Track foreground applications during active work only" /><ToggleSwitch x:Name="InterruptionHandling" Header="Enable interruption handling" /><NumberBox x:Name="InactivityMinutes" Header="Inactivity threshold minutes" Minimum="1" Maximum="1440" /><ToggleSwitch x:Name="StopIdle" Header="Stop on generic inactivity" /><ToggleSwitch x:Name="StopDisplay" Header="Stop when display turns off" /><ToggleSwitch x:Name="StopScreenSaver" Header="Stop on screen saver" /><ToggleSwitch x:Name="StopLock" Header="Stop on lock" /><ToggleSwitch x:Name="StopSuspend" Header="Stop on suspend" /><TextBlock Text="No titles, paths, browser domains, screenshots, clipboard, or keystrokes are collected." TextWrapping="Wrap" /><Button Content="Purge all application activity" Click="OnPurgeActivity" /></StackPanel></Border>
      <Border Grid.Row="3" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Windows" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="StartWindows" Header="Start with Windows" /><ToggleSwitch x:Name="Notifications" Header="Notifications" /><ToggleSwitch x:Name="Sound" Header="Sound" /><Expander Header="Layout and interface size"><StackPanel Spacing="8"><NumberBox x:Name="NavigationWidth" Header="Navigation width" Minimum="48" Maximum="160" /><NumberBox x:Name="ChannelWidth" Header="Shared channel width" Minimum="144" Maximum="360" /><NumberBox x:Name="IconScale" Header="Interface scale" Minimum="0.8" Maximum="1.5" SmallChange="0.1" /><TextBlock Text="Use Ctrl++ or Ctrl+- anywhere in TimeTrek. Ctrl+0 resets the scale." TextWrapping="Wrap" /><Button Content="Reset layout" Click="OnResetLayout" /></StackPanel></Expander></StackPanel></Border>
      <Border Grid.Row="3" Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Data" Style="{StaticResource SubtitleTextBlockStyle}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Export JSON" Click="OnExportJson" /><Button Content="Export CSV" Click="OnExportCsv" /></StackPanel><Button Content="Create backup" Click="OnCreateBackup" /><Button Content="Restore backup" Click="OnRestoreBackup" /><NumberBox x:Name="Retention" Header="Recently Deleted retention days" Minimum="1" Maximum="365" /></StackPanel></Border>
      <Border Grid.Row="4" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="UpdateChecks" Header="Check automatically" /><ToggleSwitch x:Name="UpdateDownloads" Header="Download automatically" /><Button Content="Check Now" Click="OnCheckUpdates" /></StackPanel></Border>
      <Border Grid.Row="4" Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.AboutSummary}" TextWrapping="Wrap" /><TextBlock Text="Free of charge for permitted personal, educational, and internal noncommercial use. Redistribution and product use require prior written permission." TextWrapping="Wrap" /><TextBlock Text="Windows 11 x64 is supported without an SLA. Windows 10 22H2 is compatibility-only." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><HyperlinkButton Content="License" NavigateUri="https://github.com/samzhangubc/TimeTrek/blob/main/LICENSE" Padding="0" /><HyperlinkButton Content="Third-party notices" NavigateUri="https://github.com/samzhangubc/TimeTrek/blob/main/THIRD_PARTY_NOTICES.md" Padding="0" /><HyperlinkButton Content="Repository" NavigateUri="https://github.com/samzhangubc/TimeTrek" Padding="0" /></StackPanel><Button Content="Copy Diagnostics" Click="OnCopyDiagnostics" /></StackPanel></Border>
    </Grid>
    <Button Content="Save settings" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
  </StackPanel></ScrollViewer>
</UserControl>
