<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TimeTrek.Presentation.WinUI.Reporting.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
  <ScrollViewer HorizontalScrollMode="Disabled">
    <StackPanel Padding="24" Spacing="14">
      <Grid>
        <TextBlock Text="Stats" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Raw time" Tag="Raw" Click="OnBasis" />
          <Button Content="Rounded time" Tag="Effective" Click="OnBasis" />
        </StackPanel>
      </Grid>
      <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="‹" Tag="-1" Click="OnMoveRange" AutomationProperties.Name="Previous period" />
          <Button Content="›" Tag="1" Click="OnMoveRange" AutomationProperties.Name="Next period" />
          <Button Content="Week" Tag="Week" Click="OnRange" />
          <Button Content="Month" Tag="Month" Click="OnRange" />
          <Button Content="4 months" Tag="FourMonths" Click="OnRange" />
          <Button Content="Custom" Tag="Custom" Click="OnRange" />
          <TextBlock Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
      </ScrollViewer>
      <Grid ColumnSpacing="1" Background="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Lifetime" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.LifetimeTotal, Mode=OneWay}" FontSize="20" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Selected range" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.RangeTotal, Mode=OneWay}" FontSize="20" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Daily average" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.DailyAverage, Mode=OneWay}" FontSize="20" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        <Border Grid.Column="3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Longest Session" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.LongestSession, Mode=OneWay}" FontSize="20" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        <Border Grid.Column="4" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Sessions" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}" FontSize="20" /></StackPanel></Border>
      </Grid>
      <Border Height="320" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="Activity" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Daily" Tag="Daily" Click="OnView" />
              <Button Content="Weekly" Tag="Weekly" Click="OnView" />
              <Button Content="Cumulative" Tag="Cumulative" Click="OnView" />
              <Button Content="Timeline" Tag="Timeline" Click="OnView" ToolTipService.ToolTip="Show the selected range in chronological order" />
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.DailyActivity}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="28" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding Duration}"><Border Height="{Binding BarHeight}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" VerticalAlignment="Bottom" /><TextBlock Text="{Binding Date}" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Earnings, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
      </Border>
      <Grid x:Name="LowerGrid" ColumnSpacing="20" RowSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="StreamRankings"><TextBlock Text="Top Streams" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView ItemsSource="{x:Bind ViewModel.Streams}"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Duration}" /><TextBlock Grid.Column="2" Text="{Binding Percentage}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
        <StackPanel x:Name="ProjectRankings" Grid.Column="1"><TextBlock Text="Top Projects" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView ItemsSource="{x:Bind ViewModel.Projects}"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Duration}" /><TextBlock Grid.Column="2" Text="{Binding Percentage}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
