<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TimeTrek.Presentation.WinUI.Reporting.StatsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="24" Spacing="16">
    <Grid><TextBlock Text="Stats" Style="{StaticResource TitleTextBlockStyle}" /><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="Raw" Tag="Raw" Click="OnBasis" /><Button Content="Rounded/effective" Tag="Effective" Click="OnBasis" /></StackPanel></Grid>
    <Grid ColumnSpacing="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Lifetime" /><TextBlock Text="{x:Bind ViewModel.LifetimeTotal, Mode=OneWay}" FontSize="20" /></StackPanel></Border>
      <Border Grid.Column="1" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Selected range" /><TextBlock Text="{x:Bind ViewModel.RangeTotal, Mode=OneWay}" FontSize="20" /></StackPanel></Border>
      <Border Grid.Column="2" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Daily average" /><TextBlock Text="{x:Bind ViewModel.DailyAverage, Mode=OneWay}" FontSize="20" /></StackPanel></Border>
      <Border Grid.Column="3" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Longest Session" /><TextBlock Text="{x:Bind ViewModel.LongestSession, Mode=OneWay}" FontSize="20" /></StackPanel></Border>
      <Border Grid.Column="4" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Sessions" /><TextBlock Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}" FontSize="20" /></StackPanel></Border>
    </Grid>
    <Border Height="280" Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Daily activity · last four months" Style="{StaticResource SubtitleTextBlockStyle}" /><ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"><ItemsControl ItemsSource="{x:Bind ViewModel.DailyActivity}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="24" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding Duration}"><Border Height="{Binding BarHeight}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" VerticalAlignment="Bottom" /><TextBlock Text="{Binding Date}" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Earnings, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></Border>
    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Top Streams" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView ItemsSource="{x:Bind ViewModel.Streams}"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Duration}" /><TextBlock Grid.Column="2" Text="{Binding Percentage}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Top Projects" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView ItemsSource="{x:Bind ViewModel.Projects}"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Duration}" /><TextBlock Grid.Column="2" Text="{Binding Percentage}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
    </Grid>
  </StackPanel></ScrollViewer>
</UserControl>
