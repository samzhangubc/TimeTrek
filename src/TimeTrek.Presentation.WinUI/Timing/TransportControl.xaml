<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TimeTrek.Presentation.WinUI.Timing.TransportControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="180" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" FontFamily="Consolas" FontSize="26" /></StackPanel>
        <ComboBox Grid.Column="1" Header="Stream" ItemsSource="{x:Bind ViewModel.Streams}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.SelectedStreamId, Mode=TwoWay}" PlaceholderText="Unassigned" />
        <StackPanel Grid.Column="2"><TextBox Header="Duration" Text="{x:Bind ViewModel.DurationText, Mode=TwoWay}" AutomationProperties.Name="Requested duration" /><Button Content="Apply" Click="OnApplyDuration" /></StackPanel>
        <StackPanel Grid.Column="3"><ToggleSwitch Header="Pomodoro" IsOn="{x:Bind ViewModel.IsPomodoro, Mode=TwoWay}" /><TextBlock Text="25 work · 5 break" FontSize="11" /></StackPanel>
        <InfoBar Grid.Column="4" x:Name="ErrorBar" Severity="Error" IsClosable="False" VerticalAlignment="Center" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Start" Click="OnStart" Style="{StaticResource AccentButtonStyle}" />
          <Button Content="Pause" Click="OnPause" />
          <Button Content="Resume" Click="OnResume" />
          <Button Content="Stop" Click="OnStop" />
          <Button x:Name="ConfirmTransitionButton" Content="Continue" Click="OnConfirmTransition" Visibility="Collapsed" />
          <Button x:Name="SkipTransitionButton" Content="Skip" Click="OnSkipTransition" Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="CompletionPanel" Visibility="Collapsed" Padding="20" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Bottom">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="CompletionText" Header="What did you complete?" AcceptsReturn="True" KeyDown="OnCompletionKeyDown" /><Button Grid.Column="1" Content="Save" Click="OnSaveCompletion" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" /></Grid>
    </Border>
  </Grid>
</UserControl>
