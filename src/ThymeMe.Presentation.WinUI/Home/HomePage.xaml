<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ThymeMe.Presentation.WinUI.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="HeaderGrid" ColumnSpacing="12" RowSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel x:Name="HeaderTitle">
        <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="Choose a Stream and start focused time." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBox Grid.Column="1" x:Name="NewStreamName" Header="New Stream" PlaceholderText="Course, job, hobby…" />
      <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Content="Add Stream" Click="OnAddStream" Style="{StaticResource AccentButtonStyle}" />
        <Button Content="Add Category" Click="OnAddCategory" />
        <Button Content="Add Project" Click="OnAddProject" />
      </StackPanel>
    </Grid>
    <InfoBar Grid.Row="1" x:Name="ErrorBar" Severity="Error" IsClosable="False" />
    <ListView
        Grid.Row="2"
        ItemsSource="{x:Bind ViewModel.Streams}"
        SelectionMode="None"
        HorizontalContentAlignment="Stretch"
        ScrollViewer.HorizontalScrollMode="Enabled"
        ScrollViewer.HorizontalScrollBarVisibility="Visible"
        ScrollViewer.VerticalScrollMode="Enabled"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Width="{Binding ChannelWidth}" Margin="0,0,12,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Height="120" VerticalAlignment="Center" ColumnSpacing="2" ToolTipService.ToolTip="{Binding SessionProgressText}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="6" /></Grid.ColumnDefinitions>
                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="3" />
                <Border Height="{Binding SessionFillHeight}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" VerticalAlignment="Bottom" />
                <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="3" />
                <Border Grid.Column="1" Height="{Binding BudgetFillHeight}" Background="{ThemeResource SystemFillColorAttentionBrush}" CornerRadius="3" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding BudgetProgressText}" />
              </Grid>
              <StackPanel Grid.Column="1" Spacing="10">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Content="⋯" Tag="{Binding}" Click="OnStreamSettings" AutomationProperties.Name="Stream settings" ToolTipService.ToolTip="Rename, color, budget, and archive" />
                </Grid>
                <TextBlock Text="{Binding TimerText}" FontFamily="Consolas" FontSize="24" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Stream time" />
                <Button Content="Start Timer" HorizontalAlignment="Stretch" Tag="{Binding}" Click="OnStartTimer" ToolTipService.ToolTip="Choose a duration and start this Stream." />
                <StackPanel Spacing="4">
                  <TextBlock Text="Categories" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <Button Content="{Binding CategorySummary}" Tag="{Binding}" Click="OnChooseCategories" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Project" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <ComboBox ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProjectId, Mode=TwoWay}" Tag="{Binding}" PlaceholderText="No Project" SelectionChanged="OnProjectChanged" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <Grid><TextBlock Text="Total" /><TextBlock Text="{Binding Total}" HorizontalAlignment="Right" /></Grid>
                  <Grid><TextBlock Text="Today" /><TextBlock Text="{Binding Today}" HorizontalAlignment="Right" /></Grid>
                  <Grid><TextBlock Text="This Week" /><TextBlock Text="{Binding ThisWeek}" HorizontalAlignment="Right" /></Grid>
                  <TextBlock Text="{Binding BudgetProgressText}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Content="Add Session" Tag="{Binding Id}" Click="OnAddSession" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Content="Adjust Time" Tag="{Binding Id}" Click="OnAdjust" HorizontalAlignment="Stretch" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
