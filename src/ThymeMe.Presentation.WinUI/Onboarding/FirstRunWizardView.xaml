<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ThymeMe.Presentation.WinUI.Onboarding.FirstRunWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24">
    <Grid Width="720" MaxWidth="720" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Spacing="4">
        <TextBlock Text="Welcome to Thyme-Me" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="StepTitle" Text="Your time stays yours" Style="{StaticResource SubtitleTextBlockStyle}" />
      </StackPanel>
      <ProgressBar x:Name="Progress" Grid.Row="1" Margin="0,16,0,12" Minimum="0" Maximum="5" Value="0" />

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Padding="0,0,12,12">
          <StackPanel x:Name="WelcomeStep" Spacing="14">
            <TextBlock Text="Thyme-Me keeps your Sessions, settings, exports, and backups on this computer. You do not need an account or an internet connection." TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
            <Button Content="Use recommended defaults" Click="OnUseRecommended" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
            <Button Content="Set up step by step" Click="OnBegin" HorizontalAlignment="Stretch" />
            <Button Content="Restore a backup" Click="OnRestore" HorizontalAlignment="Stretch" />
            <TextBlock Text="Recommended defaults use 25-minute Sessions, 25/5 Pomodoro, notifications on, Follow Windows appearance, and privacy-sensitive features off." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <StackPanel x:Name="OrganizationStep" Visibility="Collapsed" Spacing="12">
            <TextBlock Text="Start empty, or add editable examples to see how Streams organize your time." TextWrapping="Wrap" />
            <CheckBox Content="Create a MATH 100 example" IsChecked="{x:Bind ViewModel.Wizard.CreateMathSample, Mode=TwoWay}" />
            <CheckBox Content="Create a Work example" IsChecked="{x:Bind ViewModel.Wizard.CreateWorkSample, Mode=TwoWay}" />
            <TextBlock Text="You can rename or remove examples later without affecting anything you create yourself." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <StackPanel x:Name="TimingStep" Visibility="Collapsed" Spacing="12">
            <NumberBox x:Name="DefaultMinutes" Header="Default Session length (minutes)" Minimum="1" Maximum="10080" Value="25" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <NumberBox x:Name="WorkMinutes" Header="Pomodoro focus (minutes)" Minimum="1" Maximum="1440" Value="25" />
              <NumberBox x:Name="BreakMinutes" Grid.Column="1" Header="Pomodoro break (minutes)" Minimum="1" Maximum="1440" Value="5" />
            </Grid>
            <ToggleSwitch Header="Show Session notifications" IsOn="{x:Bind ViewModel.Wizard.NotificationsEnabled, Mode=TwoWay}" />
            <ComboBox x:Name="WeekStart" Header="Week starts on">
              <ComboBoxItem Content="Use my Windows setting" Tag="WindowsDefault" />
              <ComboBoxItem Content="Sunday" Tag="Sunday" />
              <ComboBoxItem Content="Monday" Tag="Monday" />
            </ComboBox>
          </StackPanel>

          <StackPanel x:Name="AppearanceStep" Visibility="Collapsed" Spacing="12">
            <ComboBox x:Name="Appearance" Header="Appearance">
              <ComboBoxItem Content="Follow Windows" Tag="FollowWindows" />
              <ComboBoxItem Content="Light" Tag="Light" />
              <ComboBoxItem Content="Dark" Tag="Dark" />
              <ComboBoxItem Content="Scheduled" Tag="Scheduled" />
            </ComboBox>
            <ToggleSwitch Header="Start Thyme-Me when I sign in to Windows" IsOn="{x:Bind ViewModel.Wizard.StartWithWindows, Mode=TwoWay}" />
            <TextBlock Text="You can adjust colors, contrast, schedules, and interface size later in Settings." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <StackPanel x:Name="AdvancedStep" Visibility="Collapsed" Spacing="12">
            <TextBlock Text="These features are optional. Leave them off if you only want straightforward time tracking." TextWrapping="Wrap" />
            <ToggleSwitch Header="Round tracked time for reports and billing" IsOn="{x:Bind ViewModel.Wizard.EnableRounding, Mode=TwoWay}" />
            <ToggleSwitch Header="Show billing and hourly-rate options" IsOn="{x:Bind ViewModel.Wizard.EnableBilling, Mode=TwoWay}" />
            <ToggleSwitch Header="Pause work when the computer is inactive, locked, or asleep" IsOn="{x:Bind ViewModel.Wizard.InterruptionHandlingEnabled, Mode=TwoWay}" />
            <NumberBox x:Name="InactivityMinutes" Header="Inactive for this many minutes" Minimum="1" Maximum="1440" Value="10" />
            <ToggleSwitch Header="Track which apps I use during an active Session" IsOn="{x:Bind ViewModel.Wizard.EnableForegroundTracking, Mode=TwoWay}" />
            <TextBlock Text="If enabled, Thyme-Me stores only the app name, file name, and time used. It never records window titles, typed text, screenshots, clipboard contents, or browser pages." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <StackPanel x:Name="FinishStep" Visibility="Collapsed" Spacing="14">
            <TextBlock Text="Thyme-Me is ready" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Your choices are saved locally and remain editable in Settings. Finishing setup will open Home." TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Content="Back" Click="OnBack" Visibility="Collapsed" />
        <Button x:Name="SkipButton" Grid.Column="2" Content="Skip optional setup" Click="OnSkip" Visibility="Collapsed" />
        <Button x:Name="NextButton" Grid.Column="3" Content="Next" Click="OnNext" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
        <Button x:Name="FinishButton" Grid.Column="3" Content="Finish" Click="OnFinish" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
